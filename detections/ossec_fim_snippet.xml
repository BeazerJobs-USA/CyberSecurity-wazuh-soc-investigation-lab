<!--
  Wazuh agent FIM reference for the Ubuntu endpoint.

  IMPORTANT:
  Wazuh real-time monitoring works on directories, not individual files.
  Monitor /etc/ssh in real time and let the custom rules in local_rules.xml
  restrict alerting to sshd_config and sshd_config.d/*.

  Add this <directories> entry inside the EXISTING <syscheck> block of
  /var/ossec/etc/ossec.conf. Do not add a second <syscheck> block.

  Restart after a configuration change:
    sudo systemctl restart wazuh-agent

  report_changes="yes" requests text change reporting for supported text files.
  The Wazuh diff size limit is configurable; do not assume every change will
  contain syscheck.diff without checking the generated alert.

  STATUS:
  This file is the corrected repository reference configuration. The currently
  deployed agent configuration must be verified from the live ossec.conf before
  claiming this exact snippet is active.
-->
<syscheck>
  <directories check_all="yes" report_changes="yes" realtime="yes">/etc/ssh</directories>
</syscheck>

<!--
  PLANNED WHO-DATA UPGRADE.

  Linux who-data can enrich FIM events with user/process context. Wazuh can use
  the Linux Audit subsystem as the provider. auditd is active on the endpoint,
  but this repository does not yet contain alert evidence proving who-data is
  enabled for /etc/ssh.

  Example reference:

  <syscheck>
    <directories check_all="yes" report_changes="yes" whodata="yes">/etc/ssh</directories>
    <whodata>
      <provider>audit</provider>
    </whodata>
  </syscheck>
-->
