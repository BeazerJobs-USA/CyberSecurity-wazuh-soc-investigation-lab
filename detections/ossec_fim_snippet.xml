<!--
  Wazuh agent FIM reference for the Ubuntu endpoint.

  IMPORTANT:
  Wazuh real-time monitoring works on directories, not individual files
  (syscheck reference: "Real time only works with directories, not individual
  files"). Monitor /etc/ssh in real time and let the custom rules in
  local_rules.xml restrict alerting to sshd_config and sshd_config.d/*.conf.

  Add this directories entry inside the EXISTING syscheck block of
  /var/ossec/etc/ossec.conf. Do not add a second syscheck block.

  Restart after a configuration change:
    sudo systemctl restart wazuh-agent

  report_changes="yes" asks for text diffs (syscheck.diff in the alert). Diffs
  are limited by diff_size_limit (default 50MB) and only work for text files;
  check the generated alert before claiming a diff was captured.

  How to prove which mode is live: open any FIM alert for /etc/ssh and read
  syscheck.mode ("realtime", "scheduled" or "whodata").

  STATUS:
  This is the repository reference configuration. The deployed agent
  configuration has NOT been captured yet (scripts/collect_lab_evidence.sh
  prints it, including any centralized agent.conf from the manager group).
-->
<syscheck>
  <directories check_all="yes" report_changes="yes" realtime="yes">/etc/ssh</directories>
</syscheck>

<!--
  PLANNED WHO-DATA UPGRADE (not enabled).

  Linux who-data adds user and process context to FIM alerts, using the Linux
  Audit subsystem as the provider. This repository has no evidence that auditd
  is running on the endpoint or that who-data is enabled for /etc/ssh.

  Example reference:

  <syscheck>
    <directories check_all="yes" report_changes="yes" whodata="yes">/etc/ssh</directories>
  </syscheck>
-->
